# Firebase Web App config (public client values, not service-account credentials).
# Use the same Firebase project as the backend's FIREBASE_PROJECT_ID.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Optional Firebase Web App values:
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Required Firebase Web App value:
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional, unless Firebase Analytics is configured for this app:
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Local development: call the backend directly.
NEXT_PUBLIC_BANKWISE_API_URL=http://localhost:8080
# For Firebase Hosting -> Cloud Run rewrites, leave this unset so /api/** is same-origin.
