# Local development defaults. Copy to .env and fill in values as needed.
ENVIRONMENT=local

# Exact browser origins allowed to call the API (comma-separated if multiple).
CORS_ORIGINS=http://localhost:3000

# Google Cloud. For local mode, these can stay blank unless using Vertex AI.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Production catalog (used when ENVIRONMENT=production).
# BIGQUERY_PROJECT defaults to GOOGLE_CLOUD_PROJECT when blank.
BIGQUERY_PROJECT=
BIGQUERY_DATASET=bankwise
BIGQUERY_LOCATION=US

# Production sessions (used when ENVIRONMENT=production).
# FIRESTORE_PROJECT defaults to GOOGLE_CLOUD_PROJECT when blank.
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=decision_sessions

# Source verification
SOURCE_MAX_AGE_DAYS=90

# AI
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Must match NEXT_PUBLIC_FIREBASE_PROJECT_ID in the frontend.
# Defaults to GOOGLE_CLOUD_PROJECT when blank.
FIREBASE_PROJECT_ID=

# Local auth defaults. For production, set CSRF_SECRET to a random value
# with at least 32 characters, and set AUTH_COOKIE_SECURE=true.
# Use AUTH_COOKIE_SAMESITE=none for a cross-site frontend/API deployment.
CSRF_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
